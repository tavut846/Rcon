# Caddyfile for REALITY "Steal Oneself" (Local Web Server Fallback)
#
# There are two ways to run Caddy as a REALITY fallback web server:
#
# METHOD A (Recommended with PROXY Protocol):
#   - Preserves real visitor IP addresses in Caddy logs / backend.
#   - In Rcon config: set "Xver": 1 (or 2).
#   - Requires Caddy with mastercactapus/caddy2-proxyprotocol plugin.
#   - Download prebuilt Caddy:
#     curl -o /usr/local/bin/caddy "https://caddyserver.com/api/download?os=linux&arch=amd64&p=github.com/caddy-dns/cloudflare&p=github.com/mastercactapus/caddy2-proxyprotocol"
#     chmod +x /usr/local/bin/caddy
#
# METHOD B (Simple / Standard Caddy, without PROXY Protocol):
#   - In Rcon config: set "Xver": 0.
#   - Standard official Caddy from apt/yum/official install can be used directly without plugins.
#   - Comment out or remove the entire global "servers { ... }" block below.

{
    # Listener wrapper for PROXY protocol v1/v2 from Xray fallback.
    # Note: 'allow' specifies allowed CIDRs (mastercactapus/caddy2-proxyprotocol syntax).
    servers {
        listener_wrappers {
            proxy_protocol {
                allow 127.0.0.1/32 ::1/128
            }
            tls
        }
    }
}

# Replace yourdomain.com with your node SNI domain (e.g. in001.666633.best:8001)
yourdomain.com:8001 {
    bind 127.0.0.1
    encode gzip

    # TLS Certificate Options:
    # -------------------------------------------------------------
    # Option 1: DNS-01 challenge via Cloudflare (requires caddy-dns/cloudflare plugin)
    # Ensure CLOUDFLARE_API_TOKEN environment variable is exported or present in systemd service.
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        protocols tls1.2 tls1.3
    }

    # Option 2 (Alternative): Use existing cert files (e.g. issued by Rcon, acme.sh, or certbot)
    # If using Option 2, comment out Option 1 above and uncomment the line below:
    # tls /etc/rcon/fullchain.cer /etc/rcon/cert.key
    # -------------------------------------------------------------

    # Decoy site: Reverse proxy to simulate a normal website
    reverse_proxy https://simulate-news.316293.xyz {
        header_up Host simulate-news.316293.xyz
        header_up X-Real-IP {http.request.remote}
        header_up X-Forwarded-Proto https
        header_up Cache-Control "no-cache, no-store, must-revalidate"
        header_up Pragma "no-cache"
        header_up Expires "0"

        header_down Cache-Control "no-cache, no-store, must-revalidate"
        header_down Pragma "no-cache"
        header_down Expires "0"
    }

    # Or serve local static HTML files instead of reverse proxy:
    # root * /var/www/html
    # file_server
}
