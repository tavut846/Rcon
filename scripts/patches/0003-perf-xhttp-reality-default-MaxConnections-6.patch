From c3f7a1b2e4d5f6a7b8c9d0e1f2a3b4c5d6e7f8a9 Mon Sep 17 00:00:00 2001
From: Rcon Build <rcon-build@local>
Date: Mon, 30 Jun 2026 00:00:00 +0800
Subject: [PATCH 3/3] perf: XHTTP Reality — use MaxConnections=6 default

wyx2685 sets MaxConcurrency=1 which creates one separate HTTP client
per concurrent stream, bypassing HTTP/2 multiplexing entirely. The
official xray-core v26.6.27 default is MaxConnections=6 with no
per-connection concurrency cap: 6 persistent HTTP/2 connections that
multiplex all streams.

For VLESS XHTTP Reality this matters most: Reality has high handshake
cost so minimising connection churn is critical. MaxConnections=6 with
unlimited concurrency per connection matches the upstream default and
restores proper HTTP/2 multiplexing for any panel that does not
explicitly set xmux.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 infra/conf/transport_internet.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/infra/conf/transport_internet.go b/infra/conf/transport_internet.go
--- a/infra/conf/transport_internet.go
+++ b/infra/conf/transport_internet.go
@@ -381,13 +381,13 @@ func (c *SplitHTTPConfig) Build() (proto.Message, error) {
 	if c.Xmux.MaxConnections.To > 0 && c.Xmux.MaxConcurrency.To > 0 {
 		return nil, errors.New("maxConnections cannot be specified together with maxConcurrency")
 	}
 	if c.Xmux == (XmuxConfig{}) {
-		c.Xmux.MaxConcurrency.From = 1
-		c.Xmux.MaxConcurrency.To = 1
+		c.Xmux.MaxConnections.From = 6
+		c.Xmux.MaxConnections.To = 6
 		c.Xmux.HMaxRequestTimes.From = 600
 		c.Xmux.HMaxRequestTimes.To = 900
 		c.Xmux.HMaxReusableSecs.From = 1800
 		c.Xmux.HMaxReusableSecs.To = 3000
 	}

 	config := &splithttp.Config{
