From b731cf2680ddee9cd7c2513cf46d02755ed9ceb8 Mon Sep 17 00:00:00 2001
From: Rcon Build <rcon-build@local>
Date: Mon, 15 Jun 2026 02:12:27 +0800
Subject: [PATCH 2/3] =?UTF-8?q?fix:=20AllowInsecure=20removed=20from=20tls?=
 =?UTF-8?q?.Config=20=E2=80=94=20ignore=20gracefully?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

wyx2685 now returns an error for allowInsecure, but existing panel
configs still send it. Silently ignore so panels keep working.
Panels should migrate to pinnedPeerCertSha256 / verifyPeerCertByName.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 infra/conf/transport_internet.go | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/infra/conf/transport_internet.go b/infra/conf/transport_internet.go
index 207a9447..e607f2e1 100644
--- a/infra/conf/transport_internet.go
+++ b/infra/conf/transport_internet.go
@@ -731,6 +731,7 @@ func (c *TLSConfig) Build() (proto.Message, error) {
 	config.MasterKeyLog = c.MasterKeyLog

 	if c.AllowInsecure {
-		return nil, errors.PrintRemovedFeatureError(`"allowInsecure"`, `"pinnedPeerCertSha256"(pcs) and "verifyPeerCertByName"(vcn)`)
+		// AllowInsecure was removed from tls.Config in upstream; silently ignore for panel compat.
+		// Panels should migrate to pinnedPeerCertSha256 / verifyPeerCertByName instead.
 	}
 	if c.PinnedPeerCertSha256 != "" {
